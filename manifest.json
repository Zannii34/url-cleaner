{
  "manifest_version": 3,
  "name": "URL Cleaner",
  "version": "1.0.0",
  "description": "Strips tracking parameters from URLs before you share them.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "URL Cleaner",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "clean-current-url": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Clean the current tab's URL"
    }
  }
}